function out = B_zloty_podzial(phi,A,B,eps)
k = (sqrt(5) - 1) / 2;
lambda1 = B - (B - A) * k;
val1 = phi(lambda1);
lambda2 = A + (B - A) * k;
val2 = phi(lambda2);

while abs(B - A) > eps
    if val1 > val2 
        A = lambda1;

        lambda1 = lambda2;
        val1 = val2; 
        lambda2 = A + (B - A) * k;
        val2 = phi(lambda2);
    else
        B = lambda2;

        lambda2 = lambda1;
        val2 = val1;
        lambda1 = B - (B - A) * k;
        val1 = funk(arg1{:});
    end
end

out = (A + B) / 2;
end
